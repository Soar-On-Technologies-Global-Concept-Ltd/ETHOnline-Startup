# Intentra backend configuration.
#
# Copy to .env and edit. Every key below maps to a field on Settings in app/core/config.py; unknown keys are ignored.
# Values shown are the defaults used for a local demo. Secrets are never committed — in a deployment they come from
# the platform's secret store, not from this file.
#
# For a keyless local run, set PRIVY_MODE=fake, WORLD_MODE=fake and LLM_PROVIDER=fake. Those three are rejected at
# startup when ENV is staging or prod.

# --- Core -----------------------------------------------------------------------------------------------------------
# ENV selects the safety rules: dev and test permit fake partners; staging and prod reject them and require real
# secrets of at least 16 characters for the two below.
ENV=dev
LOG_LEVEL=INFO
# Base for the signed evidence URLs the API hands out. Must be reachable by the client that will follow them.
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
# The role and database must already exist; run `alembic upgrade head` to create the tables.
DATABASE_URL=postgresql+asyncpg://intentra:intentra@127.0.0.1:5432/intentra
# HMAC key for the signed evidence URLs in app/integrations/storage.py. Rotating it invalidates every URL in flight.
SIGNING_SECRET=change-me
# HMAC key the internal chain ingress checks on POST /v1/webhooks/simulate.
INTERNAL_WEBHOOK_SECRET=change-me

# --- Arc (chain 5042002, testnet) -----------------------------------------------------------------------------------
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
# The canonical IntentraEscrow deployment and its 6-decimal USDC. Owned by the contracts team; ABI vendored in
# shared/abi/IntentraEscrow.json.
ESCROW_ADDRESS=0xeF3a099CC877F6e274b037847A6ee44C4d62648D
USDC_ADDRESS=0xFa5a5744898B71c93fF80F179d95184864143190
# Block the watcher backfills from: the escrow's deploy block. 0 replays the whole chain, which is slow.
ESCROW_DEPLOY_BLOCK=61719028
# The AI arbitrator key: one of the escrow's three signers, and the sender for AI proposals. executeWithSignatures
# requires two distinct signers, so this key alone cannot move funds. Leave empty to disable outbound chain writes.
RESOLVER_PRIVATE_KEY=
# Blocks behind the chain head the watcher stays, to avoid acting on a reorg.
CONFIRMATIONS=1
# Block span per getLogs request. Lower it if the RPC provider caps the range.
LOG_RANGE_BLOCKS=2000
EXPLORER_BASE_URL=https://testnet.arcscan.app
# Floor for maxFeePerGas. Arc charges gas in USDC; the sender never bids below this.
MIN_MAX_FEE_GWEI=20

# --- Privy (email login, embedded wallets, EIP-712) -----------------------------------------------------------------
# live verifies access tokens against Privy and needs PRIVY_APP_ID and PRIVY_VERIFICATION_KEY below;
# without them every authenticated request is rejected. fake accepts test:<id>:<wallet>:<email> tokens.
PRIVY_MODE=live
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# ES256 public key from the Privy dashboard, on one line with newlines written as \n.
PRIVY_VERIFICATION_KEY=

# --- World Selfie Check ---------------------------------------------------------------------------------------------
WORLD_MODE=live
WORLD_APP_ID=
WORLD_RP_ID=
# Hex-encoded RP signing key. Required in live mode; requesting a check without it fails with HTTP 500.
WORLD_RP_SIGNING_KEY=
WORLD_VERIFY_BASE_URL=https://developer.world.org
# Action identifiers registered with World. One nullifier per action per transaction, so a proof cannot be replayed.
WORLD_ACTION_AUTHORIZE=authorize-transaction
WORLD_ACTION_COMPLAINT=file-complaint

# --- AgentService ---------------------------------------------------------------------------------------------------
# anthropic calls the API; fake uses the deterministic handlers in app/integrations/llm/fake.py.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-5
# Per-call ceiling. On timeout the caller falls back to a template; it never guesses.
AI_TIMEOUT_SECONDS=20

# --- TrustService (The Graph on Arc) --------------------------------------------------------------------------------
# Subgraph Studio query URL for subgraph/intentra-arc. Left empty, trust scoring reports "unavailable" and ranking
# falls back to a neutral score rather than failing.
GRAPH_QUERY_URL=
GRAPH_API_KEY=
GRAPH_TIMEOUT_SECONDS=3
# Providers scoring below this are excluded from recommendations, with the reason shown to the customer.
TRUST_MIN=40

# --- Evidence storage -----------------------------------------------------------------------------------------------
# local writes to LOCAL_STORAGE_DIR; s3 uses the STORAGE_* credentials below.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./.data/evidence
STORAGE_ENDPOINT=
STORAGE_BUCKET=intentra-evidence
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Lifetime of a signed evidence URL.
SIGNED_URL_TTL_SECONDS=300
# Upload ceiling in bytes (8 MiB). Type is sniffed from the bytes, not the Content-Type header.
MAX_UPLOAD_BYTES=8388608

# --- Money and policy -----------------------------------------------------------------------------------------------
# Fixed demo rate for naira quotes. Production sources a real rate; see the schematics.
DEMO_FX_RATE_NGN_PER_USDC=1650
# Authorize or fund above this is blocked outright.
POLICY_HARD_CAP_NGN=250000
# Amount over the authorized cap but within this tolerance asks the customer again; beyond it is blocked.
ASK_TOLERANCE_BPS=1000

# --- Timers (seconds; demo values, shortened so a run finishes quickly) ---------------------------------------------
QUOTE_TTL_SECONDS=1800
AUTHORIZATION_TTL_SECONDS=900
DISPUTE_WINDOW_SECONDS=600
DELIVERY_DEADLINE_SECONDS=7200
# A complaint this close to the release deadline is refused, so it cannot race the release.
COMPLAINT_MARGIN_SECONDS=60
RESPONSE_WINDOW_SECONDS=600
ACCEPT_WINDOW_SECONDS=900

# --- Dispute ladder -------------------------------------------------------------------------------------------------
# Bounds on the automated L2 tier: a proposal below this confidence, or a dispute above this amount in micro-USDC,
# escalates to a human instead.
L2_MIN_CONFIDENCE=0.6
L2_MAX_AMOUNT_MINOR=151515151

# --- Workers --------------------------------------------------------------------------------------------------------
# Workers run only on the instance holding the Postgres advisory lock, so this may stay true on every replica.
WORKERS_ENABLED=true
WATCH_INTERVAL_SECONDS=3
RECONCILE_INTERVAL_SECONDS=15
OUTBOX_POLL_SECONDS=2
