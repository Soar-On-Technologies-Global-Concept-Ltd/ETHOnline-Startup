# Copy to .env and fill in. Secrets never go in the repo; on a deployment they live in the platform's secret store.
ENV=dev
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+asyncpg://intentra:intentra@127.0.0.1:5432/intentra
SIGNING_SECRET=change-me
INTERNAL_WEBHOOK_SECRET=change-me

# --- Arc (chain 5042002, testnet) -------------------------------------------------------------------------------
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ESCROW_ADDRESS=0xeF3a099CC877F6e274b037847A6ee44C4d62648D
ESCROW_DEPLOY_BLOCK=0
USDC_ADDRESS=0xFa5a5744898B71c93fF80F179d95184864143190
# The AI arbitrator wallet: one of the escrow's three signers, and the key that
# submits AI proposals. It cannot move money on its own.
RESOLVER_PRIVATE_KEY=
CONFIRMATIONS=1
EXPLORER_BASE_URL=https://testnet.arcscan.app
MIN_MAX_FEE_GWEI=20

# --- Privy (email login, embedded wallets, EIP-712) -------------------------------------------------------------
PRIVY_MODE=live
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# the ES256 public key from the Privy dashboard, newlines written as \n
PRIVY_VERIFICATION_KEY=

# --- World Selfie Check ------------------------------------------------------------------------------------------
WORLD_MODE=live
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_VERIFY_BASE_URL=https://developer.world.org
WORLD_ACTION_AUTHORIZE=authorize-transaction
WORLD_ACTION_COMPLAINT=file-complaint

# --- AgentService ------------------------------------------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-5
AI_TIMEOUT_SECONDS=20

# --- TrustService (The Graph on Arc) -------------------------------------------------------------------------------
GRAPH_QUERY_URL=
GRAPH_API_KEY=
GRAPH_TIMEOUT_SECONDS=3
TRUST_MIN=40

# --- Evidence storage --------------------------------------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./.data/evidence
STORAGE_ENDPOINT=
STORAGE_BUCKET=intentra-evidence
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=8388608

# --- Money, policy and timers (demo values; the production column is in the schematics) ---------------------------
DEMO_FX_RATE_NGN_PER_USDC=1650
POLICY_HARD_CAP_NGN=250000
ASK_TOLERANCE_BPS=1000
QUOTE_TTL_SECONDS=1800
AUTHORIZATION_TTL_SECONDS=900
DISPUTE_WINDOW_SECONDS=600
DELIVERY_DEADLINE_SECONDS=7200
COMPLAINT_MARGIN_SECONDS=60
RESPONSE_WINDOW_SECONDS=600
ACCEPT_WINDOW_SECONDS=900
L2_MIN_CONFIDENCE=0.6
L2_MAX_AMOUNT_MINOR=151515151

# --- Workers -------------------------------------------------------------------------------------------------------
WORKERS_ENABLED=true
WATCH_INTERVAL_SECONDS=3
RECONCILE_INTERVAL_SECONDS=15
OUTBOX_POLL_SECONDS=2
