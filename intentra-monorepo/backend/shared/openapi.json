{
  "openapi": "3.1.0",
  "info": {
    "title": "Intentra API",
    "description": "One accountable transaction, end to end: a sentence becomes a structured job, the customer authorises it\nwith a signature and a Selfie Check, USDC sits in an Arc escrow, evidence is hashed and anchored, and the money is\nreleased or split only as the two parties agreed. AI proposes, policy checks, the human authorises, the contract executes.",
    "version": "0.1.0"
  },
